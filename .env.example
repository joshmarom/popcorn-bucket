# Optional: TMDB credentials can be supplied via environment variables.
# If set, they are used only when the corresponding field is empty in Settings.
TMDB_READ_ACCESS_TOKEN=
TMDB_API_KEY=

# Optional: merge missing poster / plot / year / runtime / rating / genres / cast from OMDb (main process → www.omdbapi.com).
OMDB_API_KEY=

# Optional: TorrentClaw key (torrentclaw.com → Profile → API key). Unlocks magnets; discovery works without it.
TORRENTCLAW_API_KEY=
